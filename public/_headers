# Security headers for Cloudflare Pages.
#
# Cloudflare serves everything in public/ as-is, so this file ships to the
# edge with the island and is applied to every response. Nothing here is load
# bearing for the page: the island draws the same with or without it. It is
# the second line, for the day something does go wrong.

/*
  # Everything the island needs, and nothing else. The island builds its own
  # world at runtime — textures are drawn onto canvases, audio is synthesised
  # through Web Audio — so the only origin it reaches out to is Google Fonts.
  #
  # 'unsafe-inline' is here for styles only, never for scripts: the no-WebGL
  # card writes its own <style> element and the generated CV page inlines one.
  # blob: covers the Markdown CV the download hands over.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

  # No one frames the island on their own page.
  X-Frame-Options: DENY

  # HTTPS only. Five minutes to begin with, deliberately: browsers cache this
  # per visitor and it cannot be recalled, so a wrong value is a wrong value
  # for as long as it says. Once the domain has served clean over HTTPS for a
  # week or two, raise it to 63072000 (two years) and leave it there.
  Strict-Transport-Security: max-age=300; includeSubDomains

  # Do not let a browser guess a type the server did not send.
  X-Content-Type-Options: nosniff

  # A visitor arriving at LinkedIn or a mailto carries the origin, not the path.
  Referrer-Policy: strict-origin-when-cross-origin

  # The island asks for none of these, so the answer is settled here.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
