{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* vite/client alongside the test types: a component test pulls the
       component in, and the components read import.meta.env. */
    "types": [
      "vitest/globals",
      "node",
      "vite/client",
      "@testing-library/jest-dom/vitest"
    ],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode, the same as the app's. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. noUnusedLocals is off here and on everywhere else: a test
       often names a value to say what it is and then asserts on one field
       of it, and that is worth keeping rather than inlining. */
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* vitest.config.ts is deliberately not here. Vitest resolves its own copy
     of Vite and this project builds on rolldown-vite, so a plugin typed
     against one is handed to the other: the two agree at run time and their
     `Plugin` types do not. Vitest loads the file through esbuild, the same
     way vite.config.ts is loaded, so it is checked by neither. */
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**/*"]
}
